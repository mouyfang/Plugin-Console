{
  "name": "@local/dsh-plugin-console",
  "version": "0.1.0",
  "private": true,
  "description": "Manage third-party DSH profile plugins: update checks, enable/disable, uninstall, and health overview.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-manager"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mouyfang/Plugin-Console.git"
  },
  "homepage": "https://github.com/mouyfang/Plugin-Console#readme",
  "bugs": {
    "url": "https://github.com/mouyfang/Plugin-Console/issues"
  },
  "author": "mouyfang",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
